{
  "name": "@angel1254mc/zone-ui",
  "version": "0.1.0",
  "description": "A general-purpose, Zenless Zone Zero–inspired React UI kit for game-flavoured web apps and sites",
  "keywords": [
    "react",
    "ui",
    "ui-kit",
    "component-library",
    "design-system",
    "zenless-zone-zero",
    "zzz",
    "game-ui"
  ],
  "homepage": "https://zone.angel1254.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angel1254mc/zone-ui.git"
  },
  "bugs": {
    "url": "https://github.com/angel1254mc/zone-ui/issues"
  },
  "author": "Angel Lopez",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/zone-ui.cjs",
  "module": "./dist/zone-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zone-ui.js",
      "require": "./dist/zone-ui.cjs"
    },
    "./styles.css": "./dist/zone-ui.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && npm run build:dts-css",
    "build:dts-css": "node -e \"const fs=require('fs'),p=require('path');let n=0;for(const f of fs.readdirSync('dist',{recursive:true})){if(!f.endsWith('.d.ts'))continue;const q=p.join('dist',f),s=fs.readFileSync(q,'utf8'),t=s.replace(/^import\\s[^\\n]*\\.css[^\\n]*\\r?\\n/gm,'');if(t!==s){fs.writeFileSync(q,t);n++}}console.log('stripped CSS side-effect imports from '+n+' .d.ts files')\"",
    "build:demo": "vite build --config vite.demo.config.ts",
    "site:docgen": "node site/scripts/docgen.mjs",
    "site:dev": "react-router dev site",
    "site:build": "react-router build site",
    "site:preview": "vite preview --config site/vite.config.ts --outDir build/client",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/check-provenance.mjs --source",
    "test:watch": "vitest",
    "tokens": "node scripts/build-tokens.mjs",
    "art-manifest": "node scripts/build-art-manifest.mjs",
    "barrel": "node scripts/build-barrel.mjs",
    "check:provenance": "node scripts/check-provenance.mjs --source",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && node scripts/check-provenance.mjs --package --strict"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shiki": "^4.5.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
